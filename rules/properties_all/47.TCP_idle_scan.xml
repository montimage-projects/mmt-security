<beginning>
<!-- Property 47: Probable TCP idle scan via a zombie (nmap -sI).
     The attacker reads the zombie's IP ID with an unsolicited SYN-ACK, which the zombie answers with a RST.
     It then sends SYNs that carry the zombie's address to the target, and reads the zombie's IP ID again with
     another unsolicited SYN-ACK. The rule needs: an unsolicited SYN-ACK (its sender opened the session:
     ip.src == ip.client_addr), the zombie's RST in reply, a SYN from the zombie to a third host, and a
     second unsolicited SYN-ACK from the attacker to the zombie.
     A plain SYN scan (nmap -sS) sends no unsolicited SYN-ACK, so it is not reported.
-->
<property value="THEN" delay_units="ms" delay_min="0+" delay_max="1000" property_id="47" type_property="ATTACK"
    description="Probable TCP idle scan via a zombie: IP ID probes of a host (unsolicited SYN-ACK, RST) around SYNs that carry its address">
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="1000">
      <event value="COMPUTE" event_id="1"
             description="Unsolicited TCP [SYN, ACK] from the attacker to the zombie (IP ID probe)"
             boolean_expression="((tcp.flags == 18)&amp;&amp;((ip.src == ip.client_addr)&amp;&amp;(ip.src != ip.dst)))"/>
      <event value="COMPUTE" event_id="2"
             description="The zombie answers with a RST"
             boolean_expression="((tcp.rst == 1)&amp;&amp;((ip.src == ip.dst.1)&amp;&amp;((ip.dst == ip.src.1)&amp;&amp;((tcp.src_port == tcp.dest_port.1)&amp;&amp;(tcp.dest_port == tcp.src_port.1)))))"/>
    </operator>
    <operator value="THEN" delay_units="ms" delay_min="0+" delay_max="1000">
      <event value="COMPUTE" event_id="3"
             description="TCP SYN with the zombie's address to a third host (the scan itself)"
             boolean_expression="((tcp.flags == 2)&amp;&amp;((ip.src == ip.dst.1)&amp;&amp;(ip.dst != ip.src.1)))"/>
      <event value="COMPUTE" event_id="4"
             description="Unsolicited TCP [SYN, ACK] from the attacker to the zombie again (second IP ID probe)"
             boolean_expression="((tcp.flags == 18)&amp;&amp;((ip.src == ip.client_addr)&amp;&amp;((ip.src == ip.src.1)&amp;&amp;(ip.dst == ip.dst.1))))"/>
    </operator>
</property>
</beginning>
