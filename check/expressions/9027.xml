    description="presence test (ip.src != 0), string 'GET'">
    <event value="COMPUTE" event_id="1"
           description="presence test (ip.src != 0), string 'GET'"
           boolean_expression="((ip.src != 0) &amp;&amp; (http.method == 'GET'))"/>
